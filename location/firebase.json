{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.md",
      "check.html",
      "js/check.js",
      "scripts/**",
      "collector/**",
      "**/*adminsdk*",
      "**/*service-account*",
      "**/*serviceAccount*",
      "**/*.pem",
      "**/.env*",
      "plan.html",
      "brand-mockup.html",
      "assets/jari-logo-reference.png",
      "assets/intro-screen.png",
      "rone-*.txt",
      "*.zip"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
