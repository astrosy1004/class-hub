# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env 는 git에 올라가지 않아요)

# 임베딩(글 → 숫자) 서비스: local / gemini / openrouter
EMBEDDING_PROVIDER=local
# 답변을 쓰는 AI: gemini / openrouter / claude
LLM_PROVIDER=claude

# 모델 이름 (비워 두면 config.py 의 기본 모델을 씁니다)
EMBEDDING_MODEL=
LLM_MODEL=

# API 키 — 쓰는 서비스의 것만 채우면 됩니다
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
