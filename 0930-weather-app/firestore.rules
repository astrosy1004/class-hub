rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid} 아래는 전부(모든 깊이의 서브컬렉션 포함) 그 uid 본인만 읽고 쓸 수 있다.
    // {document=**}는 재귀 와일드카드라서 users/{uid}/history/{historyId} 같은
    // 서브컬렉션 문서도 이 규칙 하나로 이미 커버된다. 나중에 users/{uid} 밑에
    // 다른 서브컬렉션을 추가해도 이 파일을 다시 고칠 필요가 없다.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
